---
type Props = {
  href: string;
  title: string;
  category: string;
  year: number;
  summary: string;
  coverSrc: string;
  coverAlt: string;
};

const { href, title, category, year, summary, coverSrc, coverAlt } = Astro.props;
---

<article class="project-card" data-project-card>
  <a class="project-card__link" href={href}>
    <img class="project-card__image" src={coverSrc} alt={coverAlt} loading="lazy" />
    <div class="project-card__body">
      <div class="project-card__meta">
        <span>{category}</span>
        <span>{year}</span>
      </div>
      <h3>{title}</h3>
      <p>{summary}</p>
    </div>
  </a>
</article>

<style>
  .project-card {
    min-width: 0;
  }

  .project-card__link {
    display: grid;
    gap: var(--space-4);
  }

  .project-card__image {
    aspect-ratio: 4 / 5;
    width: 100%;
    border-radius: var(--radius-card);
    object-fit: cover;
    background: rgba(32, 32, 27, 0.08);
  }

  .project-card__body {
    display: grid;
    gap: var(--space-2);
  }

  .project-card__meta {
    display: flex;
    gap: var(--space-3);
    color: var(--color-muted);
    font-size: 0.82rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .project-card h3 {
    margin: 0;
    font-size: 1.2rem;
    font-weight: 500;
    letter-spacing: -0.03em;
  }

  .project-card p {
    max-width: 28rem;
    line-height: 1.6;
  }
  </style>
