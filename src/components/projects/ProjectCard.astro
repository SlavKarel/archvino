---
type Props = {
  href: string;
  title: string;
  category: string;
  year?: number;
  index: number;
  summary: string;
  coverSrc: string;
  coverAlt: string;
};

const { href, title, category, year, index, summary, coverSrc, coverAlt } = Astro.props;
---

<article class="project-card" data-project-card>
  <a class="project-card__link" href={href} aria-label={title}>
    <div class="project-card__media" data-parallax data-parallax-speed="0.12">
      <img class="project-card__image" src={coverSrc} alt={coverAlt} loading={index === 0 ? 'eager' : 'lazy'} />
      <span class="project-card__number" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
    </div>
    <div class="project-card__body" data-parallax-copy>
      <div class="project-card__meta">
        <span>{category}</span>
        {year && <span>{year}</span>}
      </div>
      <h3>{title}</h3>
      <p>{summary}</p>
    </div>
  </a>
</article>

<style>
  .project-card { min-width: 0; }

  .project-card__link {
    position: relative;
    display: block;
    min-height: min(82rem, 92vh);
    overflow: hidden;
    color: #fff;
    background: #22231f;
    border-radius: clamp(0.75rem, 2vw, 1.5rem);
  }

  .project-card__media {
    position: absolute;
    inset: -8%;
    overflow: hidden;
    transform: translate3d(0, var(--parallax-y, 0px), 0);
    will-change: transform;
  }

  .project-card__media::after {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(10, 11, 9, 0.12) 25%, rgba(10, 11, 9, 0.78) 100%);
    content: '';
  }

  .project-card__image {
    height: 100%;
    width: 100%;
    object-fit: cover;
    transition: transform 900ms cubic-bezier(0.2, 0.7, 0.2, 1);
  }

  .project-card__body {
    position: absolute;
    right: clamp(1.25rem, 4vw, 4rem);
    bottom: clamp(1.5rem, 5vw, 4.5rem);
    left: clamp(1.25rem, 4vw, 4rem);
    z-index: 2;
    display: grid;
    gap: var(--space-3);
    max-width: 52rem;
  }

  .project-card__meta {
    display: flex;
    gap: var(--space-3);
    color: rgba(255, 255, 255, 0.72);
    font-size: 0.82rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .project-card h3 {
    margin: 0;
    font-size: clamp(2.25rem, 7vw, 6.5rem);
    font-weight: 520;
    letter-spacing: -0.065em;
    line-height: 0.88;
  }

  .project-card p {
    max-width: 36rem;
    color: rgba(255, 255, 255, 0.82);
    line-height: 1.55;
  }

  .project-card__number {
    position: absolute;
    top: 10%;
    right: 8%;
    z-index: 2;
    color: rgba(255, 255, 255, 0.78);
    font-size: clamp(0.8rem, 1.5vw, 1rem);
    letter-spacing: 0.18em;
  }

  .project-card__link:hover .project-card__image { transform: scale(1.025); }

  @media (max-width: 48rem) {
    .project-card__link { min-height: 76svh; }
    .project-card__media { inset: -4%; transform: none; }
    .project-card__body { bottom: 1.5rem; }
    .project-card p { font-size: 0.92rem; }
  }

  @media (prefers-reduced-motion: reduce) {
    .project-card__media { transform: none; }
    .project-card__image { transition: none; }
  }
  </style>
