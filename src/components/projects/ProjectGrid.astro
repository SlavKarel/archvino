---
import ProjectCard from './ProjectCard.astro';

type Project = {
  slug: string;
  title: string;
  category: string;
  year: number;
  summary: string;
  coverAlt: string;
  coverSrc: string;
  href: string;
};

type Props = {
  title: string;
  kicker: string;
  projects: Project[];
};

const { title, kicker, projects } = Astro.props;
---

<section class="project-grid-section">
  <div class="project-grid-section__header">
    <p class="project-grid-section__kicker">{kicker}</p>
    <h2>{title}</h2>
  </div>
  <div class="project-grid">
    {projects.map((project) => (
      <ProjectCard
        href={project.href}
        title={project.title}
        category={project.category}
        year={project.year}
        summary={project.summary}
        coverSrc={project.coverSrc}
        coverAlt={project.coverAlt}
      />
    ))}
  </div>
</section>

<style>
  .project-grid-section {
    display: grid;
    gap: var(--space-5);
  }

  .project-grid-section__header {
    display: grid;
    gap: var(--space-2);
  }

  .project-grid-section__kicker {
    color: var(--color-muted);
    font-size: 0.78rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }

  .project-grid-section h2 {
    margin: 0;
    font-size: clamp(1.5rem, 3vw, 2rem);
    font-weight: 500;
    letter-spacing: -0.04em;
  }

  .project-grid {
    display: grid;
    gap: var(--space-5);
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }

  @media (max-width: 64rem) {
    .project-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 42rem) {
    .project-grid {
      grid-template-columns: 1fr;
    }
  }
  </style>
