---
import ProjectFilters from './ProjectFilters.astro';
import ProjectCard from './ProjectCard.astro';

type Project = {
  slug: string;
  categorySlug: string;
  title: string;
  category: string;
  year?: number;
  summary: string;
  coverAlt: string;
  coverSrc: string;
  href: string;
};

type Category = {
  slug: string;
  label: string;
};

type Props = {
  title: string;
  kicker: string;
  projects: Project[];
  categories: Category[];
  filtersLabel: string;
  allLabel: string;
};

const { title, kicker, projects, categories, filtersLabel, allLabel } = Astro.props;
---

<section class="project-grid-section" data-project-grid-section>
  <div class="project-grid-section__header">
    <p class="project-grid-section__kicker">{kicker}</p>
    <h2>{title}</h2>
  </div>
  <ProjectFilters label={filtersLabel} allLabel={allLabel} categories={categories} />
  <div class="project-grid">
    {projects.map((project, index) => (
      <div
        class="project-grid__item"
        data-project-item
        data-project-category={project.categorySlug}
        data-filter-state="visible"
      >
        <ProjectCard
          href={project.href}
          title={project.title}
          category={project.category}
          year={project.year}
          index={index}
          summary={project.summary}
          coverSrc={project.coverSrc}
          coverAlt={project.coverAlt}
        />
      </div>
    ))}
  </div>
</section>

<style>
  .project-grid-section {
    display: grid;
    gap: var(--space-6);
  }

  .project-grid-section__header {
    display: grid;
    gap: var(--space-2);
  }

  .project-grid-section__kicker {
    color: var(--color-muted);
    font-size: 0.78rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }

  .project-grid-section h2 {
    margin: 0;
    font-size: clamp(1.5rem, 3vw, 2rem);
    font-weight: 500;
    letter-spacing: -0.04em;
  }

  .project-grid {
    display: grid;
    gap: clamp(1rem, 3vw, 2.5rem);
  }

  </style>
