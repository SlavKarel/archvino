---
type Image = {
  src: string;
  alt: string;
};

type Props = {
  images: Image[];
};

const { images } = Astro.props;
---

<section class="project-gallery" data-project-gallery>
  {
    images.map((image, index) => (
      <figure class:list={["project-gallery__item", index === 0 && 'project-gallery__item--wide']}>
        <img src={image.src} alt={image.alt} loading={index === 0 ? 'eager' : 'lazy'} />
      </figure>
    ))
  }
</section>

<style>
  .project-gallery {
    display: grid;
    gap: var(--space-4);
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .project-gallery__item {
    margin: 0;
  }

  .project-gallery__item--wide {
    grid-column: 1 / -1;
  }

  .project-gallery img {
    aspect-ratio: 4 / 3;
    width: 100%;
    border-radius: var(--radius-card);
    object-fit: cover;
    background: rgba(32, 32, 27, 0.08);
  }

  @media (max-width: 48rem) {
    .project-gallery {
      grid-template-columns: 1fr;
    }

    .project-gallery__item--wide {
      grid-column: auto;
    }
  }
</style>
