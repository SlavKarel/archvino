---
type Props = {
  kicker: string;
  heading: string;
  body: string;
  href: string;
  label: string;
};

const { kicker, heading, body, href, label } = Astro.props;
---

<section class="contact-cta">
  <div class="contact-cta__copy">
    <p class="contact-cta__kicker">{kicker}</p>
    <h2>{heading}</h2>
    <p>{body}</p>
  </div>
  <a class="contact-cta__link" href={href}>{label}</a>
</section>

<style>
  .contact-cta {
    display: grid;
    gap: var(--space-5);
    align-items: end;
    grid-template-columns: minmax(0, 1fr) auto;
    padding: var(--space-6);
    border: 1px solid var(--color-line);
    border-radius: calc(var(--radius-card) + 0.25rem);
    background: linear-gradient(180deg, rgba(255, 255, 255, 0.55), rgba(255, 255, 255, 0.82));
  }

  .contact-cta__copy {
    display: grid;
    gap: var(--space-3);
    max-width: 34rem;
  }

  .contact-cta__kicker {
    color: var(--color-muted);
    font-size: 0.78rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }

  .contact-cta h2 {
    margin: 0;
    font-size: clamp(1.6rem, 4vw, 2.3rem);
    font-weight: 500;
    letter-spacing: -0.04em;
    line-height: 1.05;
  }

  .contact-cta__link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 3.25rem;
    padding: 0 var(--space-5);
    border-radius: 999px;
    background: var(--color-text);
    color: var(--color-bg);
  }

  @media (max-width: 48rem) {
    .contact-cta {
      grid-template-columns: 1fr;
    }
  }
  </style>
