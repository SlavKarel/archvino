---
type Props = {
  headline: string;
  intro: string;
};

const { headline, intro } = Astro.props;
---

<section class="home-intro">
  <p class="home-intro__eyebrow">archvino</p>
  <h1>{headline}</h1>
  <p class="home-intro__body">{intro}</p>
</section>

<style>
  .home-intro {
    display: grid;
    gap: var(--space-4);
    max-width: 42rem;
    padding-block: var(--space-6) var(--space-7);
  }

  .home-intro__eyebrow {
    color: var(--color-muted);
    font-size: 0.78rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }

  .home-intro__body {
    max-width: 34rem;
    font-size: 1.05rem;
    line-height: 1.7;
  }
  </style>
