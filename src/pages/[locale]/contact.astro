---
import { getCollection } from 'astro:content';

import ContactForm from '../../components/contact/ContactForm.astro';
import ContactLinks from '../../components/site/ContactLinks.astro';
import PageLayout from '../../layouts/PageLayout.astro';
import { getSiteSettings, type ContactPage } from '../../lib/content';
import { getLocalizedValue, isLocale, LOCALES, type Locale } from '../../lib/i18n';
import { buildSeo } from '../../lib/seo';

export function getStaticPaths() {
  return LOCALES.map((locale) => ({ params: { locale } }));
}

const { locale: localeParam } = Astro.params;

if (!localeParam || !isLocale(localeParam)) {
  return Astro.redirect('/ru/');
}

const locale: Locale = localeParam;
const settings = await getSiteSettings();
const pages = await getCollection('pages');
const entry = pages.find((item) => item.id === 'contact');

if (!entry) {
  throw new Error('missing contact page content');
}

const contact = entry.data as ContactPage;
const title = getLocalizedValue(contact.heading, locale);
const formHelper = contact.formHelper ? getLocalizedValue(contact.formHelper, locale) : getLocalizedValue(contact.intro, locale);
const contactEndpoint = import.meta.env.PUBLIC_CONTACT_FORM_ENDPOINT || '';
const seo = await buildSeo(locale, {
  title: `${title} | ${settings.studioName}`,
  description: getLocalizedValue(contact.intro, locale),
});

const socialLinks = contact.socialLinks.map((link) => ({
  label: getLocalizedValue(link.label, locale),
  url: link.url,
}));
---

<PageLayout
  locale={locale}
  pathname={Astro.url.pathname}
  settings={settings}
  title={seo.title}
  description={seo.description}
>
  <section class="contact-page">
    <div class="contact-page__intro page-intro">
      <h1>{title}</h1>
      <p>{getLocalizedValue(contact.intro, locale)}</p>
    </div>

    <div class="contact-page__body">
      <ContactLinks
        locale={locale}
        email={contact.email}
        phone={contact.phone}
        address={getLocalizedValue(contact.address, locale)}
        mapUrl={contact.mapUrl}
        socialLinks={socialLinks}
      />

      <ContactForm
        action={contactEndpoint}
        helper={formHelper}
        labels={{
          name: getLocalizedValue(contact.formLabels.name, locale),
          email: getLocalizedValue(contact.formLabels.email, locale),
          message: getLocalizedValue(contact.formLabels.message, locale),
          submit: getLocalizedValue(contact.formLabels.submit, locale),
        }}
        validation={{
          required: getLocalizedValue(contact.formMessages.required, locale),
          invalidEmail: getLocalizedValue(contact.formMessages.invalidEmail, locale),
        }}
        feedback={{
          success: getLocalizedValue(contact.formMessages.success, locale),
          error: getLocalizedValue(contact.formMessages.error, locale),
          sending: getLocalizedValue(contact.formMessages.sending, locale),
        }}
      />
    </div>
  </section>
</PageLayout>

<style>
  .contact-page {
    display: grid;
    gap: var(--space-6);
  }

  .contact-page__body {
    display: grid;
    gap: var(--space-5);
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
    align-items: start;
  }

  @media (max-width: 56rem) {
    .contact-page__body {
      grid-template-columns: 1fr;
    }
  }
</style>
