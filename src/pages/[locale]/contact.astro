---
import { getCollection } from 'astro:content';

import ContactLinks from '../../components/site/ContactLinks.astro';
import PageLayout from '../../layouts/PageLayout.astro';
import { getSiteSettings, type ContactPage } from '../../lib/content';
import { getLocalizedValue, isLocale, LOCALES, type Locale } from '../../lib/i18n';
import { buildSeo } from '../../lib/seo';

export function getStaticPaths() {
  return LOCALES.map((locale) => ({ params: { locale } }));
}

const { locale: localeParam } = Astro.params;

if (!localeParam || !isLocale(localeParam)) {
  return Astro.redirect('/ru/');
}

const locale: Locale = localeParam;
const settings = await getSiteSettings();
const pages = await getCollection('pages');
const entry = pages.find((item) => item.id === 'contact');

if (!entry) {
  throw new Error('missing contact page content');
}

const contact = entry.data as ContactPage;
const title = getLocalizedValue(contact.heading, locale);
const formHelper = contact.formHelper ? getLocalizedValue(contact.formHelper, locale) : getLocalizedValue(contact.intro, locale);
const seo = await buildSeo(locale, {
  title: `${title} | ${settings.studioName}`,
  description: getLocalizedValue(contact.intro, locale),
});

const socialLinks = contact.socialLinks.map((link) => ({
  label: getLocalizedValue(link.label, locale),
  url: link.url,
}));
---

<PageLayout
  locale={locale}
  pathname={Astro.url.pathname}
  settings={settings}
  title={seo.title}
  description={seo.description}
>
  <section class="contact-page">
    <div class="contact-page__intro page-intro">
      <h1>{title}</h1>
      <p>{getLocalizedValue(contact.intro, locale)}</p>
    </div>

    <div class="contact-page__body">
      <ContactLinks
        locale={locale}
        email={contact.email}
        phone={contact.phone}
        address={getLocalizedValue(contact.address, locale)}
        mapUrl={contact.mapUrl}
        socialLinks={socialLinks}
      />

      <section class="contact-page__form-block" aria-label={locale === 'ru' ? 'Форма контакта' : 'Contact form'}>
        <p>{formHelper}</p>

        <form class="contact-form">
          <label>
            <span>{getLocalizedValue(contact.formLabels.name, locale)}</span>
            <input type="text" name="name" autocomplete="name" />
          </label>

          <label>
            <span>{getLocalizedValue(contact.formLabels.email, locale)}</span>
            <input type="email" name="email" autocomplete="email" />
          </label>

          <label>
            <span>{getLocalizedValue(contact.formLabels.message, locale)}</span>
            <textarea name="message" rows={6}></textarea>
          </label>

          <button type="submit">{getLocalizedValue(contact.formLabels.submit, locale)}</button>
        </form>
      </section>
    </div>
  </section>
</PageLayout>

<style>
  .contact-page {
    display: grid;
    gap: var(--space-6);
  }

  .contact-page__body {
    display: grid;
    gap: var(--space-5);
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
    align-items: start;
  }

  .contact-page__form-block {
    display: grid;
    gap: var(--space-4);
    padding: var(--space-4);
    border: 1px solid var(--color-line);
    background: color-mix(in srgb, var(--color-surface) 65%, transparent);
  }

  .contact-form {
    display: grid;
    gap: var(--space-3);
  }

  .contact-form label {
    display: grid;
    gap: var(--space-2);
  }

  .contact-form span {
    color: var(--color-muted);
    font-size: 0.9rem;
  }

  .contact-form input,
  .contact-form textarea,
  .contact-form button {
    width: 100%;
    border: 1px solid var(--color-line);
    border-radius: 0;
    background: transparent;
    color: var(--color-text);
    font: inherit;
  }

  .contact-form input,
  .contact-form textarea {
    padding: 0.9rem 1rem;
  }

  .contact-form textarea {
    resize: vertical;
  }

  .contact-form button {
    width: fit-content;
    padding: 0.9rem 1.25rem;
    cursor: pointer;
    transition: color var(--duration-base) var(--ease-base),
      border-color var(--duration-base) var(--ease-base);
  }

  .contact-form button:hover,
  .contact-form button:focus-visible {
    color: var(--color-muted);
    border-color: color-mix(in srgb, var(--color-text) 20%, var(--color-line));
  }

  @media (max-width: 56rem) {
    .contact-page__body {
      grid-template-columns: 1fr;
    }
  }
</style>
