---
import ProjectFacts from '../../../components/projects/ProjectFacts.astro';
import ProjectGallery from '../../../components/projects/ProjectGallery.astro';
import ProjectSections from '../../../components/projects/ProjectSections.astro';
import ProjectLayout from '../../../layouts/ProjectLayout.astro';
import { getSiteSettings } from '../../../lib/content';
import { isLocale, type Locale } from '../../../lib/i18n';
import { getProjectBySlug, getProjectCategories, getProjectSlugs } from '../../../lib/projects';
import { buildProjectStaticPaths } from '../../../lib/routes';
import { buildProjectSeo } from '../../../lib/seo';

export async function getStaticPaths() {
  return buildProjectStaticPaths(await getProjectSlugs());
}

const { locale: localeParam, slug } = Astro.params;

if (!localeParam || !isLocale(localeParam) || !slug) {
  return Astro.redirect('/ru/');
}

const locale: Locale = localeParam;

const [settings, project, categories] = await Promise.all([
  getSiteSettings(),
  getProjectBySlug(slug, locale),
  getProjectCategories(locale),
]);

if (!project) {
  return Astro.redirect(`/${locale}/`);
}

const categoryLabel = categories.find((category) => category.slug === project.category)?.label ?? project.category;
const seo = await buildProjectSeo(locale, {
  title: project.title,
  summary: project.summary,
  location: project.location,
  year: project.year,
  status: project.status,
  image: project.cover.src,
});

const facts = [
  {
    label: locale === 'ru' ? 'Год' : 'Year',
    value: project.year,
  },
  {
    label: locale === 'ru' ? 'Место' : 'Location',
    value: project.location,
  },
  {
    label: locale === 'ru' ? 'Статус' : 'Status',
    value: project.status,
  },
];

const eyebrow = `${categoryLabel} / ${project.year}`;
---

<ProjectLayout
  locale={locale}
  pathname={Astro.url.pathname}
  settings={settings}
  title={seo.title}
  description={seo.description}
  eyebrow={eyebrow}
  heading={project.title}
  summary={project.summary}
  heroSrc={project.cover.src}
  heroAlt={project.cover.alt}
>
  <ProjectFacts facts={facts} />
  <ProjectGallery images={project.gallery} />
  <ProjectSections sections={project.sections} />
</ProjectLayout>
