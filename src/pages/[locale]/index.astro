---
import PageLayout from '../../layouts/PageLayout.astro';
import AboutPreview from '../../components/sections/AboutPreview.astro';
import ContactCta from '../../components/sections/ContactCta.astro';
import HomeIntro from '../../components/sections/HomeIntro.astro';
import ProjectGrid from '../../components/projects/ProjectGrid.astro';
import ServicesPreview from '../../components/sections/ServicesPreview.astro';
import { getHomePageContent, getSiteSettings } from '../../lib/content';
import { LOCALES, isLocale, type Locale } from '../../lib/i18n';
import { getProjectCategories, getProjects } from '../../lib/projects';
import { buildPagePath, buildProjectPath } from '../../lib/routes';
import { buildDefaultSeo } from '../../lib/seo';

export function getStaticPaths() {
  return LOCALES.map((locale) => ({ params: { locale } }));
}

const { locale: localeParam } = Astro.params;

if (!localeParam || !isLocale(localeParam)) {
  return Astro.redirect('/ru/');
}

const locale: Locale = localeParam;

const [settings, home, seo, projects, categories] = await Promise.all([
  getSiteSettings(),
  getHomePageContent(locale),
  buildDefaultSeo(locale),
  getProjects(locale),
  getProjectCategories(locale),
]);

const categoryLabels = new Map(categories.map((category) => [category.slug, category.label]));

const featuredProjects = home.featuredProjectSlugs
  .map((slug) => projects.find((project) => project.slug === slug))
  .filter((project) => project !== undefined)
  .map((project) => ({
    slug: project.slug,
    categorySlug: project.category,
    title: project.title,
    category: categoryLabels.get(project.category) ?? project.category,
    year: project.year,
    summary: project.summary,
    coverAlt: project.cover.alt,
    coverSrc: project.cover.src,
    href: buildProjectPath(locale, project.slug),
  }));
---

<PageLayout
  locale={locale}
  pathname={Astro.url.pathname}
  settings={settings}
  title={seo.title}
  description={seo.description}
  image={seo.image}
>
  <div class="home-flow">
    <HomeIntro headline={home.headline} intro={home.intro} />

    <ProjectGrid
      kicker={locale === 'ru' ? 'Избранное' : 'Selected work'}
      title={locale === 'ru' ? 'Избранные проекты' : 'Featured projects'}
      projects={featuredProjects}
      categories={categories}
      filtersLabel={locale === 'ru' ? 'Фильтр проектов' : 'Filter projects'}
      allLabel={locale === 'ru' ? 'Все' : 'All'}
    />

    <section class="home-preview-grid">
      <ServicesPreview
        title={locale === 'ru' ? 'Услуги' : 'Services'}
        body={home.servicesPreview}
        href={buildPagePath(locale, 'services')}
        linkLabel={locale === 'ru' ? 'Подробнее' : 'Learn more'}
      />
      <AboutPreview
        title={locale === 'ru' ? 'О студии' : 'About'}
        body={home.aboutPreview}
        href={buildPagePath(locale, 'about')}
        linkLabel={locale === 'ru' ? 'Открыть' : 'Open'}
      />
    </section>

    <ContactCta
      kicker={locale === 'ru' ? 'Контакты' : 'Contact'}
      heading={home.contactCta.heading}
      body={home.contactCta.body}
      href={buildPagePath(locale, 'contact')}
      label={home.contactCta.label}
    />
  </div>
</PageLayout>

<script>
  import initMotion from '../../scripts/motion';
  import initProjectFilters from '../../scripts/project-filters';

  initMotion();
  initProjectFilters();
</script>

<style>
  .home-flow {
    display: grid;
    gap: var(--space-7);
  }

  .home-preview-grid {
    display: grid;
    gap: var(--space-4);
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  @media (max-width: 48rem) {
    .home-preview-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
